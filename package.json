{
  "name": "typing-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch",
    "db:init": "bun src/db/init.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "alpinejs": "^3.16.1",
    "bcryptjs": "^3.0.2",
    "hono": "^4.6.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
